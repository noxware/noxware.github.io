---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt: string;
  class?: string;
}

const { image, alt, class: className = "" } = Astro.props;
---

<div class:list={["inline-block overflow-hidden rounded-full", className]}>
  <a class="block h-full w-full" href={image.src}>
    <Image src={image} alt={alt} class="h-full w-full rounded-full object-cover" />
  </a>
</div>
