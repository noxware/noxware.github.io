---
import Reveal from "./Reveal.astro";

interface Props {
  image: string;
  name: string;
  description: string;
  align?: "left" | "right";
}

const { image, name, description, align = "left" } = Astro.props;
const revealClass = [
  "mb-12 flex w-full last:mb-0",
  align === "right" ? "justify-end self-end" : "justify-start self-start",
].join(" ");
---

<Reveal direction="bottom" class={revealClass}>
  <article class="flex max-w-full items-center">
    <img class="mr-4 h-20 w-20 object-scale-down min-[730px]:h-25 min-[730px]:w-25" src={image} alt="" loading="lazy" />
    <div class="flex max-w-100 flex-col text-[0.9em] min-[600px]:text-[1em]">
      <h3 class="mb-[0.3rem] text-[1.3em] leading-none">{name}</h3>
      <p>{description}</p>
    </div>
  </article>
</Reveal>
