---
import Reveal from "./Reveal.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Reveal direction="bottom" class="w-full max-w-[850px] first-of-type:[&_h3]:mt-0">
  <section class="w-full">
    <h3 class="mb-6 mt-6 w-full text-center text-[1.2em] font-normal leading-none min-[730px]:text-[1.3em]">{title}</h3>
    <div class="flex flex-row flex-wrap justify-center">
      <slot />
    </div>
  </section>
</Reveal>
