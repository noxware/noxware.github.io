---
import SectionTitle from "../components/SectionTitle.astro";
---

<section class="flex flex-row flex-wrap items-center justify-center bg-brand px-8 py-8 text-white">
  <SectionTitle>Links and contact</SectionTitle>
  <div class="h-0 w-full"></div>
  <ul class="mt-6 flex w-full flex-col items-center justify-center min-[900px]:flex-row">
    <li class="contact-link m-[0.3rem] text-[0.8em] min-[420px]:text-[1em] min-[900px]:m-0">
      <a class="p-0.5 text-white no-underline underline-offset-4 hover:underline focus-visible:underline" href="https://www.linkedin.com/in/franco-profeti/" rel="noreferrer" target="_blank">Linkedin</a>
    </li>
    <li class="contact-link m-[0.3rem] text-[0.8em] min-[420px]:text-[1em] min-[900px]:m-0">
      <a class="p-0.5 text-white no-underline underline-offset-4 hover:underline focus-visible:underline" href="https://github.com/noxware" rel="noreferrer" target="_blank">Github</a>
    </li>
  </ul>
</section>

<style>
  @media (min-width: 900px) {
    .contact-link::before {
      display: inline-block;
      margin-right: 1em;
      margin-left: 1em;
      content: "|";
    }

    .contact-link:first-of-type::before {
      display: none;
    }
  }
</style>
